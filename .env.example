# Database is provisioned by Replit and injected automatically.

# Start in synthetic preview mode. Set to live only after the adapters in
# LIVE_DATA_SETUP.md have been implemented and verified.
MRIP_DATA_MODE=synthetic

# Google Earth Engine
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON=secrets/gee-service-account.json

# GSI Bhukosh raw download directory
BHUKOSH_DATA_DIR=data/raw/bhukosh

# Copernicus Climate Data Store / ERA5
CDS_API_KEY=

# Verified MOIL production extract (CSV or normalized source file)
MOIL_PRODUCTION_DATA_PATH=data/raw/moil/production.csv